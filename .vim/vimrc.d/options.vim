
" general options

" identation and tabs

set autoindent
set smartindent
set tabstop=4
set shiftwidth=4
set expandtab

" line numbers

set number
set relativenumber

" search

set ignorecase
set smartcase
set hlsearch

" mouse and scrolling

set scrolloff=10
set mouse=a

" persistant undo

set undodir=~/.vim/undodir
set undofile

" viminfo location

set viminfo+=n~/.vim/.viminfo
