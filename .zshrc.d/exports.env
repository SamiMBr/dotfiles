#PATH
export_path(){
local path_list=("$HOME/.local/bin" "$HOME/node_modules/.bin" "$HOME/scripts" "$HOME/.cargo/bin")
local item

for item in "${path_list[@]}"; do
    if ! [[ "$PATH" =~ $item ]]; then
        PATH="$PATH:$item"
    fi
done
}
export_path  
export PATH

export EDITOR="/usr/bin/vimx"
export HISTSIZE=1000000
export HISTFILESIZE=1000000


# libvirt
export LIBVIRT_DEFAULT_URI="qemu:///system"

# less pager
export LESS="-R --mouse --wheel-lines=4"

# less pager color (to show man pages headings with blue)
export GROFF_NO_SGR=1
export LESS_TERMCAP_md=$'\e[1;38;2;61;174;233m'   # For Headers and bold text ! 
export LESS_TERMCAP_me=$'\e[0m'       # reset

# fzf
export FZF_DEFAULT_OPTS="--reverse --no-height --style minimal"
export FZF_CTRL_T_OPTS="
  --walker-skip .git,node_modules,target
  --preview-window 'right:70%'
  --preview 'fzf-preview.sh {}'
  --bind 'ctrl-h:change-preview-window(down|hidden|)'"
export FZF_ALT_C_OPTS="
  --walker-skip .git,node_modules,target
  --preview-window 'right:70%'
  --preview 'tree -C {}'"
export FZF_COMPLETION_PATH_OPTS="
  --walker-skip .git,node_modules,target
  --preview-window 'right:70%'
  --preview 'fzf-preview.sh {}'
  --bind 'ctrl-h:change-preview-window(down|hidden|)'"
